{
  "name": "tardis-desktop",
  "productName": "TARDIS",
  "version": "0.3.3",
  "description": "Bigger on the inside. The desktop shell for a TARDIS server.",
  "license": "MIT",
  "private": true,
  "author": "TARDIS contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrchevyceleb/TARDIS.git"
  },
  "main": "dist/main.js",
  "desktopName": "tardis.desktop",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "dist": "node scripts/sync-version.mjs && npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2"
  }
}
