{
  "name": "tardis-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:codex-models": "tsx --test src/chat/codex-models.test.ts"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.15.7",
    "@supabase/supabase-js": "^2.49.0",
    "@types/compression": "^1.8.1",
    "chokidar": "^5.0.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "livekit-server-sdk": "^2.17.0",
    "playwright-core": "1.62.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
