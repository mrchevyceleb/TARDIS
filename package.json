{
  "name": "tardis",
  "private": true,
  "version": "0.3.3",
  "description": "Bigger on the inside. A local-first, always-on multi-agent office for Claude, Codex, Grok, GLM, and local models.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrchevyceleb/TARDIS.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22",
    "npm": ">=10"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "npm --workspace server run dev",
    "build": "tsc -b && vite build && npm --workspace server run build",
    "preview": "vite preview",
    "start": "npm --workspace server run start",
    "typecheck": "tsc -b && npm --workspace server run typecheck",
    "test": "npm --workspace server run test",
    "computer:host": "tsx server/src/devices/host.ts",
    "deadcode": "knip --include files,dependencies,unlisted,devDependencies",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "icons:native": "node scripts/generate-native-icons.mjs",
    "version": "node desktop/scripts/sync-version.mjs && git add desktop/package.json desktop/package-lock.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@tanstack/react-query": "^5.90.0",
    "livekit-client": "^2.20.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "knip": "^5.88.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  }
}
