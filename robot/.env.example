# Where the ship is. Use the HTTPS tailnet address from `tailscale serve status`
# on the server, or http://127.0.0.1:8091 when running on the server itself.
TARDIS_URL=https://your-server.your-tailnet.ts.net

# How the robot introduces itself to the companions.
TARDIS_ROBOT_NAME=Spark

# auto | doly | mock. auto uses the Doly SDK when it is importable, else mock.
TARDIS_ROBOT_HARDWARE=auto

# Voice through Jarvis: auto | on | off. auto enables it when the server has
# LiveKit configured and the livekit/sounddevice packages are installed.
TARDIS_VOICE=auto
# openWakeWord model: a bundled name (hey_jarvis ships with openWakeWord and is
# the closest bundled phrase), a path to a custom .onnx model such as one trained
# for "hey Spark" with openWakeWord's training notebook, or off.
TARDIS_WAKE_WORD=hey_jarvis
TARDIS_WAKE_THRESHOLD=0.5
# A long press on a touch pad also summons voice (1/0).
TARDIS_TOUCH_SUMMON=1
# Seconds of silence before the robot ends a voice call on its own.
TARDIS_VOICE_IDLE_SECS=45
# Half-duplex gate: mute the mic while Jarvis speaks (1/0). Leave on unless
# you have echo cancellation working.
TARDIS_VOICE_GATE=1
# Try LiveKit's software echo canceller as well (1/0).
TARDIS_VOICE_AEC=0

# Optional sounddevice names or indexes for the microphones and speaker.
# TARDIS_AUDIO_INPUT=
# TARDIS_AUDIO_OUTPUT=
TARDIS_ROBOT_VOLUME=70

# Resting eye colours (Doly colour names).
TARDIS_EYE_COLOR=SKY_BLUE
TARDIS_EYE_BACKGROUND=BLACK

# Where the pairing identity and logs live.
# TARDIS_ROBOT_STATE_DIR=/var/lib/tardis-robot
TARDIS_LOG_LEVEL=INFO
