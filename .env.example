# Core server
PORT=8091
# TARDIS has no app-layer login. Keep loopback unless a trusted reverse
# proxy/private network is your authentication boundary.
HOST=127.0.0.1
ELROND_WORKSPACE_PATH=/absolute/path/to/your/ASSISTANT-HUB
# RIVENDELL_STATE_DIR=/absolute/path/to/private/state
# Keep this synchronized with -WorkspaceRoot when installing the Windows handler.
VITE_RIVENDELL_WINDOWS_WORKSPACE_PATH="C:\ASSISTANT-HUB"

# Worker queue. dry-run never launches a real agent or performs external work.
RIVENDELL_WORKER_ENABLED=true
RIVENDELL_WORKER_RUNNER=dry-run
RIVENDELL_WORKER_POLL_MS=10000
# Opt in only after your agent CLIs/providers are configured.
RIVENDELL_PREWARM_AGENTS=false

# Optional calendar presentation for a two-source MCP calendar feed.
RIVENDELL_CALENDAR_PRIMARY_LABEL=Primary
RIVENDELL_CALENDAR_PRIMARY_NAME="Primary calendar"
RIVENDELL_CALENDAR_PRIMARY_COLOR="#6aa3ff"
RIVENDELL_CALENDAR_SECONDARY_LABEL=Secondary
RIVENDELL_CALENDAR_SECONDARY_NAME="Secondary calendar"
RIVENDELL_CALENDAR_SECONDARY_COLOR="#d4af63"
# Comma-separated substrings matched against source/account/calendar fields.
RIVENDELL_CALENDAR_SECONDARY_MARKERS=secondary

# Optional durable queue/event storage (server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional assistant/MCP backend. Leave blank to run without it.
ASSISTANT_ADMIN_BASE_URL=
ASSISTANT_ADMIN_TOKEN=
ASSISTANT_MCP_URL=
ASSISTANT_MCP_TOKEN=
# RIVENDELL_ASSISTANT_MCP_PROXY=/absolute/path/to/mcp-proxy.js
# RIVENDELL_BROWSER_MCP=/absolute/path/to/browser-mcp-server.mjs
# RIVENDELL_ACCOUNT_MAP=/absolute/path/to/account-map.json
# RIVENDELL_DEFAULT_CLI_ACCOUNT=team-profile
# RIVENDELL_ALLOWED_ORIGINS=https://rivendell.example.ts.net
# RIVENDELL_OBSERVED_JOBS_FILE=/absolute/path/to/read-only-jobs.json
# Hand notable robot events (touch, edge, pick-up, low battery) to one companion.
# RIVENDELL_ROBOT_AGENT=Chief of Staff
# Standing authorization for companions to drive/turn the robot and move its arms.
# Off by default: expression, speech, lights, camera and sensors still work.
# RIVENDELL_ROBOT_ALLOW_MOTION=true
# ASSISTANT_MCP_ENV_PATH=/absolute/path/to/an/explicitly-shared.env

# Optional model providers. Claude Code and Codex may instead use their local
# authenticated CLI sessions.
Z_AI_API_KEY=
GROK_PERSONAL_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
# XAI_OAUTH_CLIENT_ID=public-oauth-client-id
# RIVENDELL_ZAI_MODEL=glm-5.3[1m]
# RIVENDELL_XAI_MODEL=grok-4.6
# Keep provider-capacity failures prompt instead of waiting through retry storms.
RIVENDELL_CLAUDE_MAX_RETRIES=1
RIVENDELL_XAI_MAX_RETRIES=1
# Short proxy-level retries for transient xAI capacity responses (0-3).
RIVENDELL_XAI_FAST_RETRIES=2

# Optional Railway redeploy button. All values are required.
RAILWAY_API_TOKEN=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=

# Optional voice/Jarvis support.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ELEVENLABS_API_KEY=
PICOVOICE_ACCESS_KEY=
